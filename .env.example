# =============================================================================
# Copy to .env.local (gitignored) and fill in real values. Never commit secrets.
# =============================================================================

# Supabase (Settings → API). New-format keys are drop-in compatible with the
# old var names below: put the "publishable" key in ANON, the "secret" key in
# SERVICE_ROLE. ANON/publishable is browser-safe (RLS-protected); SERVICE_ROLE/
# secret is server-only (bypasses RLS — used by the cron pipeline).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon OR sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=             # service_role OR sb_secret_... (server-side only)

# Google Sheets API — service account (Cloud Console → IAM & Admin → Service
# Accounts → Create → Keys → Add key → JSON). Paste the downloaded JSON's
# content here as ONE LINE (raw or base64 — a raw multi-line blob breaks
# standard .env parsing). The sheet itself must separately be shared with
# that key's client_email (Viewer is enough) — a service account has no
# access until you share a sheet with it, same as adding any other collaborator.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Per-city spreadsheet id (the long id in the sheet's URL between /d/ and
# /edit). Each city's spreadsheet has separate "Outward" (direction=OUT) and
# "Inward" (direction=IN) tabs — override outwardSheet/inwardSheet per city if
# a tab is ever named differently. Column order is read from the header
# row's text, not fixed positions; the connector always pulls the last 200
# real data rows of each tab (see lib/connectors/sheets.ts).
# {"DELHI":{"spreadsheetId":"..."},"MUMBAI":{"spreadsheetId":"...","inwardSheet":"Inward "}, ...}
SHEETS_CONFIG=

# DB MODEL.md §5/§6/§10. These are for the direct JSON-RPC/Postgres
# alternatives if you switch transport later (lib/connectors/odoo.ts).
# For direct-Postgres transport instead, use a connection string:
# ODOO_PG_URL=postgresql://user:pass@host:5432/odoo

# Metabase (analytics.rentofurniture.com) — the Odoo connector's transport.
# Auth: either an API key (preferred), OR a username+password session (pick one).
METABASE_URL=https://analytics.rentofurniture.com
METABASE_API_KEY=
# METABASE_USERNAME=
# METABASE_PASSWORD=
# Numeric database id for the "Odoo Live Database" connection — confirmed = 5
# (DT's Mongo connection is 6). Discover via GET /api/database if it changes.
# Which Metabase database is the Delivery Tracker. The gate app reads trucks
# and delivery agents from it through Metabase rather than a MongoDB login, so
# no separate DT credential has to be provisioned. Defaults to 6.
METABASE_DT_DB_ID=6
METABASE_ODOO_DB_ID=5

# Delivery Tracker (MongoDB). Store the full connection string here — NOT in code.
DT_MONGODB_URI=
DT_MONGODB_DB=cityfurnish
# Parent collection joined to orderfromcityfurnishes (barcode lines). DB MODEL.md
# named it "tasks", but that collection is empty on the live cluster — the real
# one is "deliveries" (the default). Override only if it's renamed again.
DT_TASKS_COLLECTION=deliveries
# (legacy HTTP-API vars, unused if reading Mongo directly)

# Guard OCR — Azure Document Intelligence, "prebuilt-layout" model (async submit
# + poll). Returns real table structure (rows/cols/cells) so the handwritten
# register's columns — and the per-character barcode boxes — reconstruct
# reliably. Works on the multi-service AI resource; endpoint looks like
# https://<resource>.services.ai.azure.com or .cognitiveservices.azure.com.
# (Var names kept as AZURE_VISION_* to avoid churn.)
AZURE_VISION_ENDPOINT=
AZURE_VISION_API_KEY=

# Email — Gmail SMTP (Path B, app password; no service account needed).
# 1. On the sending Google account (ops@cityfurnish.com) turn ON 2-Step
#    Verification, then create an App Password at
#    https://myaccount.google.com/apppasswords (pick "Mail").
# 2. Paste the 16-char password below (spaces are stripped automatically).
GMAIL_USER=ops@cityfurnish.com
GMAIL_APP_PASSWORD=
# Who receives the daily digest (comma-separated). Defaults to GMAIL_USER if blank.
DIGEST_RECIPIENTS=
# Absolute site URL for the email's "View Dashboard" button (optional).
# On Vercel this falls back to VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=

# Cron protection — random secret; must match the scheduler's Authorization header
CRON_SECRET=

# =============================================================================
# Added Sept 2026 — read by the code but missing from this file for months.
# =============================================================================

# Metabase session auth, as an alternative to METABASE_API_KEY. Set EITHER the
# API key above OR this pair; the connector accepts either (lib/connectors/metabase.ts).
METABASE_USERNAME=
METABASE_PASSWORD=

# The Delivery Tracker's database id INSIDE Metabase — used by the gate app's
# fleet list and the DT half of the expected list. Defaults to 6 if unset, which
# is why nothing appeared to break while it was undocumented.
METABASE_DT_DB_ID=6

# Portal chat assistant (console.groq.com). Optional: without it the assistant
# reports itself unavailable and nothing else changes. GROQ_MODEL overrides the
# default llama-3.3-70b-versatile.
GROQ_API_KEY=
GROQ_MODEL=

# Google Drive mirror for guard-register PDFs. Optional — Supabase Storage stays
# the source of truth and mirroring is a silent no-op when unset. The folders MUST
# live in a Shared Drive: a service account has no My-Drive quota. Uses the same
# GOOGLE_SERVICE_ACCOUNT_KEY as Sheets.
# {"DELHI":"1Ab..","MUMBAI":"1Cd..", ...}
GDRIVE_FOLDERS=
GDRIVE_FOLDER_ID=

# WHICH CITIES READ THE GATE APP instead of the OCR'd paper register.
# Comma-separated, e.g. DELHI. EMPTY MEANS EVERY CITY IS STILL ON PAPER, which is
# the current production state — the gate app is a silent pilot. A city listed here
# does NOT fall back to OCR if the app returns nothing (see lib/connectors/guard.ts).
GATE_APP_CITIES=

# =============================================================================
# SET THIS TO 1 ON ANY DEPLOYMENT THAT IS NOT PRODUCTION.
# The cron routes then decline their work and return 200 without running. Without
# it, a second deployment of this repo reconciles the same days as production and
# emails the same founders. Leave EMPTY on production only.
# =============================================================================
SCHEDULED_JOBS_DISABLED=

# Read-only Postgres login for the scripts in scripts/ (gate-status.mjs etc).
# Optional — only the diagnostic scripts use it, never the app.
DATABASE_READONLY_URL=
